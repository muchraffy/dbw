[
  {
    "id": "theme_1793413878149",
    "name": "kopi susu",
    "content": "<!DOCTYPE html>\n<html lang=\"id\" class=\"scroll-smooth\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>The Wedding of {{NAMA_PRIA}} & {{NAMA_WANITA}}</title>\n  <!-- Tailwind CSS -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- Google Fonts -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Great+Vibes&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap\" rel=\"stylesheet\" />\n  <!-- Font Awesome -->\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\" />\n  <style>\n    :root {\n      --bg-cream: #F9F6F0;\n      --bg-sand: #EFECE6;\n      --text-dark: #2C2623;\n      --accent-gold: #8C7355;\n      --accent-light: #C5B39B;\n    }\n    body {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n      background-color: #161413;\n      color: var(--text-dark);\n      overflow-x: hidden;\n    }\n    .font-serif-luxury {\n      font-family: 'Cormorant Garamond', serif;\n    }\n    .font-script {\n      font-family: 'Great Vibes', cursive;\n    }\n    .lock-scroll {\n      overflow: hidden !important;\n      height: 100vh !important;\n    }\n    .spin-slow {\n      animation: spin 8s linear infinite;\n    }\n    @keyframes spin {\n      from { transform: rotate(0deg); }\n      to { transform: rotate(360deg); }\n    }\n    .fade-up {\n      opacity: 0;\n      transform: translateY(32px);\n      transition: all 0.9s cubic-bezier(0.22, 1, 0.36, 1);\n    }\n    .fade-up.visible {\n      opacity: 1;\n      transform: translateY(0);\n    }\n    .arch-frame {\n      border-radius: 220px 220px 24px 24px;\n    }\n    .glass-dark {\n      background: rgba(28, 24, 21, 0.65);\n      backdrop-filter: blur(12px);\n      -webkit-backdrop-filter: blur(12px);\n      border: 1px solid rgba(197, 179, 155, 0.3);\n    }\n    .glass-light {\n      background: rgba(255, 255, 255, 0.85);\n      backdrop-filter: blur(10px);\n      -webkit-backdrop-filter: blur(10px);\n      border: 1px solid rgba(140, 115, 85, 0.2);\n    }\n    /* Custom Scrollbar */\n    ::-webkit-scrollbar {\n      width: 5px;\n    }\n    ::-webkit-scrollbar-track {\n      background: #F9F6F0;\n    }\n    ::-webkit-scrollbar-thumb {\n      background: #8C7355;\n      border-radius: 10px;\n    }\n  </style>\n</head>\n<body class=\"lock-scroll antialiased selection:bg-[#8C7355] selection:text-white\">\n\n  <!-- PEMUTAR MUSIK LATAR -->\n  <audio id=\"bgm\" loop preload=\"auto\">\n    <source src=\"{{MUSIC_URL}}\" type=\"audio/mpeg\" />\n  </audio>\n\n  <!-- FLOATING TOMBOL PLAY/PAUSE MUSIK -->\n  <button id=\"music-btn\" onclick=\"toggleMusic()\" aria-label=\"Putar / Jeda Musik\" class=\"fixed bottom-6 right-6 z-40 hidden w-12 h-12 rounded-full bg-[#2C2623]/90 text-[#F9F6F0] shadow-2xl border border-[#C5B39B]/50 flex items-center justify-center transition-all duration-300 hover:scale-110 focus:outline-none\">\n    <i id=\"music-icon\" class=\"fas fa-compact-disc text-xl spin-slow\"></i>\n  </button>\n\n  <!-- SAMPUL / COVER PEMBUKA LAYAR PENUH (KI-27 EDITORIAL STYLE) -->\n  <div id=\"cover-overlay\" class=\"fixed inset-0 z-50 flex flex-col justify-between items-center text-center px-6 py-12 bg-cover bg-center transition-all duration-1000 ease-in-out\" style=\"background-image: linear-gradient(to bottom, rgba(22, 20, 19, 0.45), rgba(22, 20, 19, 0.88)), url('{{BG_1}}');\">\n    \n    <!-- Header Cover -->\n    <div class=\"mt-6 space-y-2\">\n      <p class=\"uppercase tracking-[0.35em] text-[11px] text-[#EFECE6]/90 font-medium\">The Wedding Of</p>\n      <h1 class=\"font-serif-luxury text-5xl sm:text-6xl text-[#F9F6F0] font-semibold tracking-wide\">\n        {{NAMA_PRIA}} <span class=\"font-script text-4xl text-[#C5B39B] font-normal mx-1\">&amp;</span> {{NAMA_WANITA}}\n      </h1>\n      <p class=\"text-xs tracking-[0.25em] uppercase text-[#C5B39B] pt-1\">{{TANGGAL_ACARA}}</p>\n    </div>\n\n    <!-- Box Nama Tamu & Tombol Buka -->\n    <div class=\"w-full max-w-xs glass-dark rounded-3xl p-6 text-[#F9F6F0] shadow-2xl mb-4\">\n      <p class=\"text-xs uppercase tracking-[0.2em] text-[#C5B39B] mb-2\">Dear</p>\n      <p class=\"text-xs text-[#EFECE6]/80 mb-1\">Kepada Yth. Bapak/Ibu/Saudara/i</p>\n      <h2 id=\"nama-tamu-display\" class=\"font-serif-luxury text-2xl font-semibold text-white tracking-wide my-3 break-words\">Tamu Spesial</h2>\n      <div class=\"w-12 h-[1px] bg-[#C5B39B]/40 mx-auto my-4\"></div>\n      <button onclick=\"openInvitation()\" class=\"w-full py-3 px-6 rounded-full bg-[#8C7355] hover:bg-[#755f45] text-white text-xs uppercase tracking-[0.2em] font-medium transition-all duration-300 shadow-lg flex items-center justify-center gap-2 group\">\n        <i class=\"fas fa-envelope-open-text transition-transform group-hover:-translate-y-0.5\"></i>\n        <span>Buka Undangan</span>\n      </button>\n    </div>\n  </div>\n\n  <!-- CONTAINER UTAMA MOBILE-FIRST (KI-27) -->\n  <main class=\"max-w-md mx-auto bg-[#F9F6F0] min-h-screen shadow-2xl relative overflow-hidden\">\n\n    <!-- 1. HERO & COUNTDOWN SECTION -->\n    <section class=\"relative min-h-screen flex flex-col justify-end items-center text-center px-6 pb-14 pt-24 bg-cover bg-center\" style=\"background-image: linear-gradient(to bottom, rgba(28, 24, 21, 0.25) 0%, rgba(28, 24, 21, 0.75) 65%, #2C2623 100%), url('{{BG_1}}');\">\n      <div class=\"fade-up w-full\">\n        <p class=\"uppercase tracking-[0.35em] text-xs text-[#EFECE6] mb-2\">The Wedding Of</p>\n        <h2 class=\"font-serif-luxury text-5xl text-[#F9F6F0] font-semibold mb-2\">\n          {{NAMA_PRIA}} <span class=\"font-script text-3xl text-[#C5B39B] font-normal\">&amp;</span> {{NAMA_WANITA}}\n        </h2>\n        <p class=\"text-xs tracking-[0.25em] uppercase text-[#C5B39B] mb-8\">{{TANGGAL_ACARA}}</p>\n\n        <!-- Countdown Timer (KI-27 Style) -->\n        <div class=\"grid grid-cols-4 gap-2.5 max-w-xs mx-auto mb-7\">\n          <div class=\"glass-dark rounded-2xl py-3 px-2 text-[#F9F6F0]\">\n            <span id=\"cd-days\" class=\"block font-serif-luxury text-2xl font-bold text-[#C5B39B]\">00</span>\n            <span class=\"text-[10px] uppercase tracking-widest text-[#EFECE6]/80\">Hari</span>\n          </div>\n          <div class=\"glass-dark rounded-2xl py-3 px-2 text-[#F9F6F0]\">\n            <span id=\"cd-hours\" class=\"block font-serif-luxury text-2xl font-bold text-[#C5B39B]\">00</span>\n            <span class=\"text-[10px] uppercase tracking-widest text-[#EFECE6]/80\">Jam</span>\n          </div>\n          <div class=\"glass-dark rounded-2xl py-3 px-2 text-[#F9F6F0]\">\n            <span id=\"cd-minutes\" class=\"block font-serif-luxury text-2xl font-bold text-[#C5B39B]\">00</span>\n            <span class=\"text-[10px] uppercase tracking-widest text-[#EFECE6]/80\">Menit</span>\n          </div>\n          <div class=\"glass-dark rounded-2xl py-3 px-2 text-[#F9F6F0]\">\n            <span id=\"cd-seconds\" class=\"block font-serif-luxury text-2xl font-bold text-[#C5B39B]\">00</span>\n            <span class=\"text-[10px] uppercase tracking-widest text-[#EFECE6]/80\">Detik</span>\n          </div>\n        </div>\n\n        <!-- Simpan di Kalender -->\n        <a href=\"#acara\" class=\"inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-[#C5B39B] text-[#F9F6F0] hover:bg-[#8C7355] hover:border-[#8C7355] text-xs uppercase tracking-[0.2em] transition-all duration-300\">\n          <i class=\"far fa-calendar-check\"></i>\n          <span>Simpan di Kalender</span>\n        </a>\n      </div>\n    </section>\n\n    <!-- 2. QUOTES & DOA SECTION -->\n    <section class=\"relative py-16 px-8 text-center bg-cover bg-center\" style=\"background-image: linear-gradient(rgba(249, 246, 240, 0.92), rgba(249, 246, 240, 0.95)), url('{{BG_2}}');\">\n      <div class=\"fade-up max-w-sm mx-auto\">\n        <div class=\"w-10 h-10 rounded-full bg-[#8C7355]/10 text-[#8C7355] flex items-center justify-center mx-auto mb-5\">\n          <i class=\"fas fa-quote-left text-sm\"></i>\n        </div>\n        <p class=\"font-serif-luxury italic text-lg leading-relaxed text-[#2C2623] mb-4\">\n          \"{{QUOTES}}\"\n        </p>\n        <div class=\"w-14 h-[1px] bg-[#8C7355]/40 mx-auto my-5\"></div>\n        <p class=\"text-xs leading-relaxed text-[#2C2623]/80 font-light\">\n          {{DOA}}\n        </p>\n      </div>\n    </section>\n\n    <!-- 3. GROOM & BRIDE SECTION -->\n    <section class=\"py-16 px-6 bg-[#EFECE6] text-center relative\">\n      <div class=\"fade-up mb-12\">\n        <p class=\"uppercase tracking-[0.3em] text-[10px] text-[#8C7355] mb-1\">Assalamu'alaikum Wr. Wb.</p>\n        <h2 class=\"font-serif-luxury text-4xl font-semibold text-[#2C2623]\">Groom &amp; Bride</h2>\n        <div class=\"w-12 h-[1px] bg-[#8C7355] mx-auto mt-3\"></div>\n      </div>\n\n      <!-- Mempelai Pria -->\n      <div class=\"fade-up mb-12\">\n        <div class=\"relative w-56 h-72 mx-auto mb-6 p-2 border border-[#8C7355]/40 arch-frame shadow-lg bg-[#F9F6F0]\">\n          <img src=\"{{GALERI_1}}\" alt=\"{{NAMA_LENGKAP_PRIA}}\" onerror=\"this.src='https://placehold.co/600x800/d6cec2/2c2623?text=Groom'\" class=\"w-full h-full object-cover arch-frame\" />\n        </div>\n        <p class=\"font-script text-3xl text-[#8C7355] mb-1\">{{NAMA_PRIA}}</p>\n        <h3 class=\"font-serif-luxury text-2xl font-bold text-[#2C2623] tracking-wide mb-2\">{{NAMA_LENGKAP_PRIA}}</h3>\n        <p class=\"text-xs text-[#2C2623]/80 leading-relaxed max-w-xs mx-auto font-medium\">\n          {{ORTU_PRIA}}\n        </p>\n        <p class=\"text-[11px] text-[#8C7355] mt-1\">\n          Putra dari Bapak {{AYAH_PRIA}} &amp; Ibu {{IBU_PRIA}}\n        </p>\n      </div>\n\n      <!-- Divider \"&\" -->\n      <div class=\"fade-up my-8 flex items-center justify-center gap-4\">\n        <div class=\"w-16 h-[1px] bg-[#8C7355]/30\"></div>\n        <span class=\"font-script text-4xl text-[#8C7355]\">&amp;</span>\n        <div class=\"w-16 h-[1px] bg-[#8C7355]/30\"></div>\n      </div>\n\n      <!-- Mempelai Wanita -->\n      <div class=\"fade-up\">\n        <div class=\"relative w-56 h-72 mx-auto mb-6 p-2 border border-[#8C7355]/40 arch-frame shadow-lg bg-[#F9F6F0]\">\n          <img src=\"{{GALERI_2}}\" alt=\"{{NAMA_LENGKAP_WANITA}}\" onerror=\"this.src='https://placehold.co/600x800/d6cec2/2c2623?text=Bride'\" class=\"w-full h-full object-cover arch-frame\" />\n        </div>\n        <p class=\"font-script text-3xl text-[#8C7355] mb-1\">{{NAMA_WANITA}}</p>\n        <h3 class=\"font-serif-luxury text-2xl font-bold text-[#2C2623] tracking-wide mb-2\">{{NAMA_LENGKAP_WANITA}}</h3>\n        <p class=\"text-xs text-[#2C2623]/80 leading-relaxed max-w-xs mx-auto font-medium\">\n          {{ORTU_WANITA}}\n        </p>\n        <p class=\"text-[11px] text-[#8C7355] mt-1\">\n          Putri dari Bapak {{AYAH_WANITA}} &amp; Ibu {{IBU_WANITA}}\n        </p>\n      </div>\n    </section>\n\n    <!-- 4. LOVE STORY SECTION (KI-27 TIMELINE) -->\n    <section class=\"py-16 px-6 bg-[#F9F6F0]\">\n      <div class=\"fade-up text-center mb-10\">\n        <p class=\"uppercase tracking-[0.3em] text-[10px] text-[#8C7355] mb-1\">Our Journey</p>\n        <h2 class=\"font-serif-luxury text-4xl font-semibold text-[#2C2623]\">Love Story</h2>\n        <div class=\"w-12 h-[1px] bg-[#8C7355] mx-auto mt-3\"></div>\n      </div>\n\n      <div class=\"fade-up space-y-6 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-[#C5B39B] before:to-transparent\">\n        <!-- Awal Bertemu -->\n        <div class=\"relative flex items-start gap-4\">\n          <div class=\"w-10 h-10 rounded-full bg-[#8C7355] text-white flex items-center justify-center shrink-0 shadow-md z-10\">\n            <i class=\"fas fa-heart text-xs\"></i>\n          </div>\n          <div class=\"bg-white p-5 rounded-2xl shadow-sm border border-[#C5B39B]/30 flex-1\">\n            <h3 class=\"font-serif-luxury text-xl font-bold text-[#2C2623] mb-1\">Awal Bertemu</h3>\n            <p class=\"text-xs text-[#2C2623]/75 leading-relaxed\">\n              Tidak ada yang kebetulan di dunia ini. Pertemuan pertama kami menjadi awal dari cerita panjang yang penuh rasa syukur dan kebahagiaan.\n            </p>\n          </div>\n        </div>\n\n        <!-- Lamaran -->\n        <div class=\"relative flex items-start gap-4\">\n          <div class=\"w-10 h-10 rounded-full bg-[#8C7355] text-white flex items-center justify-center shrink-0 shadow-md z-10\">\n            <i class=\"fas fa-ring text-xs\"></i>\n          </div>\n          <div class=\"bg-white p-5 rounded-2xl shadow-sm border border-[#C5B39B]/30 flex-1\">\n            <h3 class=\"font-serif-luxury text-xl font-bold text-[#2C2623] mb-1\">Lamaran</h3>\n            <p class=\"text-xs text-[#2C2623]/75 leading-relaxed\">\n              Dengan restu kedua orang tua, kami memantapkan hati untuk mengikat janji dalam ikatan pertunangan menuju ibadah terpanjang.\n            </p>\n          </div>\n        </div>\n\n        <!-- Menikah -->\n        <div class=\"relative flex items-start gap-4\">\n          <div class=\"w-10 h-10 rounded-full bg-[#8C7355] text-white flex items-center justify-center shrink-0 shadow-md z-10\">\n            <i class=\"fas fa-dove text-xs\"></i>\n          </div>\n          <div class=\"bg-white p-5 rounded-2xl shadow-sm border border-[#C5B39B]/30 flex-1\">\n            <h3 class=\"font-serif-luxury text-xl font-bold text-[#2C2623] mb-1\">Menikah</h3>\n            <p class=\"text-xs text-[#2C2623]/75 leading-relaxed\">\n              Hari yang dinanti tiba. Pada {{TANGGAL_ACARA}}, kami siap melangkah bersama membangun keluarga sakinah, mawaddah, warahmah.\n            </p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 5. SAVE THE DATE / ACARA SECTION -->\n    <section id=\"acara\" class=\"py-16 px-6 bg-cover bg-center relative\" style=\"background-image: linear-gradient(to bottom, rgba(28, 24, 21, 0.82), rgba(28, 24, 21, 0.92)), url('{{BG_3}}');\">\n      <div class=\"fade-up text-center mb-10 text-[#F9F6F0]\">\n        <p class=\"uppercase tracking-[0.3em] text-[10px] text-[#C5B39B] mb-1\">Save The Date</p>\n        <h2 class=\"font-serif-luxury text-4xl font-semibold\">Wedding Event</h2>\n        <div class=\"w-12 h-[1px] bg-[#C5B39B] mx-auto mt-3\"></div>\n      </div>\n\n      <!-- Card Akad Nikah -->\n      <div class=\"fade-up glass-light rounded-3xl p-7 text-center mb-6 shadow-xl\">\n        <div class=\"w-12 h-12 rounded-full bg-[#8C7355]/15 text-[#8C7355] flex items-center justify-center mx-auto mb-3\">\n          <i class=\"fas fa-handshake-simple text-lg\"></i>\n        </div>\n        <h3 class=\"font-serif-luxury text-3xl font-bold text-[#2C2623] mb-2\">Akad Nikah</h3>\n        <div class=\"w-10 h-[1px] bg-[#8C7355]/40 mx-auto mb-4\"></div>\n        <p class=\"text-xs uppercase tracking-widest text-[#8C7355] font-semibold mb-1\">Waktu Pelaksanaan</p>\n        <p class=\"font-serif-luxury text-lg font-semibold text-[#2C2623] mb-4\">{{TANGGAL_ACARA}}</p>\n        <p class=\"text-xs uppercase tracking-widest text-[#8C7355] font-semibold mb-1\">Bertempat di :</p>\n        <p class=\"text-xs text-[#2C2623]/85 leading-relaxed mb-6\">{{LOKASI_ACARA}}</p>\n        <a href=\"{{MAPS_LINK}}\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#2C2623] hover:bg-[#8C7355] text-white text-xs uppercase tracking-[0.2em] transition-all duration-300 shadow-md\">\n          <i class=\"fas fa-location-dot\"></i>\n          <span>Google Maps</span>\n        </a>\n      </div>\n\n      <!-- Card Resepsi -->\n      <div class=\"fade-up glass-light rounded-3xl p-7 text-center shadow-xl\">\n        <div class=\"w-12 h-12 rounded-full bg-[#8C7355]/15 text-[#8C7355] flex items-center justify-center mx-auto mb-3\">\n          <i class=\"fas fa-champagne-glasses text-lg\"></i>\n        </div>\n        <h3 class=\"font-serif-luxury text-3xl font-bold text-[#2C2623] mb-2\">Resepsi</h3>\n        <div class=\"w-10 h-[1px] bg-[#8C7355]/40 mx-auto mb-4\"></div>\n        <p class=\"text-xs uppercase tracking-widest text-[#8C7355] font-semibold mb-1\">Waktu Pelaksanaan</p>\n        <p class=\"font-serif-luxury text-lg font-semibold text-[#2C2623] mb-4\">{{TANGGAL_ACARA}}</p>\n        <p class=\"text-xs uppercase tracking-widest text-[#8C7355] font-semibold mb-1\">Bertempat di :</p>\n        <p class=\"text-xs text-[#2C2623]/85 leading-relaxed mb-6\">{{LOKASI_ACARA}}</p>\n        <a href=\"{{MAPS_LINK}}\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#2C2623] hover:bg-[#8C7355] text-white text-xs uppercase tracking-[0.2em] transition-all duration-300 shadow-md\">\n          <i class=\"fas fa-location-dot\"></i>\n          <span>Google Maps</span>\n        </a>\n      </div>\n    </section>\n\n    <!-- 6. GALERI FOTO (4 FOTO WAJIB) -->\n    <section class=\"py-16 px-6 bg-[#EFECE6]\">\n      <div class=\"fade-up text-center mb-10\">\n        <p class=\"uppercase tracking-[0.3em] text-[10px] text-[#8C7355] mb-1\">Our Moments</p>\n        <h2 class=\"font-serif-luxury text-4xl font-semibold text-[#2C2623]\">Photo Gallery</h2>\n        <div class=\"w-12 h-[1px] bg-[#8C7355] mx-auto mt-3\"></div>\n      </div>\n\n      <!-- Grid 4 Foto -->\n      <div class=\"fade-up grid grid-cols-2 gap-3.5\">\n        <div class=\"overflow-hidden rounded-2xl shadow-md aspect-[3/4] bg-[#F9F6F0] border border-[#C5B39B]/40 group\">\n          <img src=\"{{GALERI_1}}\" alt=\"Galeri 1\" onclick=\"openLightbox(this.src)\" onerror=\"this.src='https://placehold.co/600x800/d6cec2/2c2623?text=Gallery+1'\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 cursor-pointer\" />\n        </div>\n        <div class=\"overflow-hidden rounded-2xl shadow-md aspect-[3/4] bg-[#F9F6F0] border border-[#C5B39B]/40 group mt-5\">\n          <img src=\"{{GALERI_2}}\" alt=\"Galeri 2\" onclick=\"openLightbox(this.src)\" onerror=\"this.src='https://placehold.co/600x800/d6cec2/2c2623?text=Gallery+2'\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 cursor-pointer\" />\n        </div>\n        <div class=\"overflow-hidden rounded-2xl shadow-md aspect-[3/4] bg-[#F9F6F0] border border-[#C5B39B]/40 group -mt-5\">\n          <img src=\"{{GALERI_3}}\" alt=\"Galeri 3\" onclick=\"openLightbox(this.src)\" onerror=\"this.src='https://placehold.co/600x800/d6cec2/2c2623?text=Gallery+3'\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 cursor-pointer\" />\n        </div>\n        <div class=\"overflow-hidden rounded-2xl shadow-md aspect-[3/4] bg-[#F9F6F0] border border-[#C5B39B]/40 group\">\n          <img src=\"{{GALERI_4}}\" alt=\"Galeri 4\" onclick=\"openLightbox(this.src)\" onerror=\"this.src='https://placehold.co/600x800/d6cec2/2c2623?text=Gallery+4'\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 cursor-pointer\" />\n        </div>\n      </div>\n    </section>\n\n    <!-- 7. WEDDING GIFT / AMPLOP DIGITAL -->\n    <section class=\"py-16 px-6 bg-[#F9F6F0] text-center\">\n      <div class=\"fade-up\">\n        <p class=\"uppercase tracking-[0.3em] text-[10px] text-[#8C7355] mb-1\">Tanda Kasih</p>\n        <h2 class=\"font-serif-luxury text-4xl font-semibold text-[#2C2623] mb-3\">Wedding Gift</h2>\n        <div class=\"w-12 h-[1px] bg-[#8C7355] mx-auto mb-5\"></div>\n        <p class=\"text-xs text-[#2C2623]/75 leading-relaxed max-w-xs mx-auto mb-8\">\n          Tanpa mengurangi rasa hormat kami, bagi Bapak/Ibu/Saudara/i yang ingin mengirimkan tanda kasih kepada kedua mempelai dapat melalui :\n        </p>\n\n        <!-- Kartu ATM / Rekening -->\n        <div class=\"bg-gradient-to-br from-[#2C2623] via-[#3b332f] to-[#1e1a18] text-[#F9F6F0] rounded-3xl p-6 shadow-xl border border-[#C5B39B]/30 text-left relative overflow-hidden max-w-xs mx-auto\">\n          <div class=\"absolute -right-8 -top-8 w-28 h-28 rounded-full bg-[#C5B39B]/10\"></div>\n          <div class=\"flex justify-between items-center mb-6\">\n            <span class=\"text-xs uppercase tracking-[0.25em] text-[#C5B39B]\">Digital Envelope</span>\n            <span class=\"font-serif-luxury text-xl font-bold tracking-wider text-white\">{{BANK_NAME}}</span>\n          </div>\n          <div class=\"mb-5\">\n            <p class=\"text-[10px] uppercase tracking-widest text-[#EFECE6]/60 mb-1\">Nomor Rekening</p>\n            <p id=\"rekening-number\" class=\"font-mono text-xl tracking-widest font-semibold text-[#C5B39B]\">{{BANK_ACCOUNT}}</p>\n          </div>\n          <div class=\"flex justify-between items-end\">\n            <div>\n              <p class=\"text-[10px] uppercase tracking-widest text-[#EFECE6]/60 mb-0.5\">Atas Nama</p>\n              <p class=\"text-sm font-medium text-white\">{{BANK_HOLDER}}</p>\n            </div>\n            <button onclick=\"copyAccount()\" class=\"px-4 py-2 rounded-xl bg-[#8C7355] hover:bg-[#a18666] text-white text-xs font-medium flex items-center gap-1.5 transition-all shadow-md\">\n              <i id=\"copy-icon\" class=\"far fa-copy\"></i>\n              <span id=\"copy-text\">Salin</span>\n            </button>\n          </div>\n        </div>\n        <!-- Notifikasi Salin -->\n        <p id=\"copy-toast\" class=\"text-xs text-[#8C7355] font-medium mt-3 opacity-0 transition-opacity duration-300\">\n          <i class=\"fas fa-check-circle mr-1\"></i> Nomor rekening berhasil disalin!\n        </p>\n      </div>\n    </section>\n\n    <!-- 8. RSVP & WEDDING WISH SECTION -->\n    <section class=\"py-16 px-6 bg-[#EFECE6]\">\n      <div class=\"fade-up text-center mb-8\">\n        <p class=\"uppercase tracking-[0.3em] text-[10px] text-[#8C7355] mb-1\">Reservation</p>\n        <h2 class=\"font-serif-luxury text-4xl font-semibold text-[#2C2623]\">RSVP &amp; Wishes</h2>\n        <div class=\"w-12 h-[1px] bg-[#8C7355] mx-auto mt-3 mb-3\"></div>\n        <p class=\"text-xs text-[#2C2623]/75\">Tuliskan doa dan konfirmasi kehadiran Anda untuk kami</p>\n      </div>\n\n      <div class=\"fade-up bg-[#F9F6F0] p-6 rounded-3xl shadow-md border border-[#C5B39B]/30 mb-8\">\n        <form id=\"wish-form\" onsubmit=\"submitWish(event)\" class=\"space-y-4\">\n          <div>\n            <label class=\"block text-xs font-medium text-[#2C2623] mb-1\">Nama Anda</label>\n            <input type=\"text\" id=\"input-nama\" required placeholder=\"Masukkan nama Anda\" class=\"w-full px-4 py-2.5 rounded-xl bg-white border border-[#C5B39B]/50 text-xs focus:outline-none focus:border-[#8C7355]\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-[#2C2623] mb-1\">Konfirmasi Kehadiran</label>\n            <select id=\"input-hadir\" class=\"w-full px-4 py-2.5 rounded-xl bg-white border border-[#C5B39B]/50 text-xs focus:outline-none focus:border-[#8C7355]\">\n              <option value=\"Hadir\">Hadir</option>\n              <option value=\"Tidak Hadir\">Tidak Hadir</option>\n              <option value=\"Masih Ragu\">Masih Ragu</option>\n            </select>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-[#2C2623] mb-1\">Ucapan &amp; Doa</label>\n            <textarea id=\"input-pesan\" rows=\"3\" required placeholder=\"Tuliskan doa dan ucapan terbaik...\" class=\"w-full px-4 py-2.5 rounded-xl bg-white border border-[#C5B39B]/50 text-xs focus:outline-none focus:border-[#8C7355]\"></textarea>\n          </div>\n          <button type=\"submit\" class=\"w-full py-3 rounded-xl bg-[#2C2623] hover:bg-[#8C7355] text-white text-xs uppercase tracking-[0.2em] font-medium transition-all duration-300 shadow-md\">\n            Kirim Ucapan\n          </button>\n        </form>\n      </div>\n\n      <!-- Daftar Ucapan -->\n      <div id=\"wish-list\" class=\"fade-up space-y-3 max-h-72 overflow-y-auto pr-1\">\n        <div class=\"bg-[#F9F6F0] p-4 rounded-2xl border border-[#C5B39B]/25\">\n          <div class=\"flex justify-between items-center mb-1\">\n            <h4 class=\"font-semibold text-xs text-[#2C2623]\">Keluarga Besar</h4>\n            <span class=\"text-[10px] px-2.5 py-0.5 rounded-full bg-[#8C7355]/15 text-[#8C7355] font-medium\">Hadir</span>\n          </div>\n          <p class=\"text-xs text-[#2C2623]/75 leading-relaxed\">Selamat menempuh hidup baru {{NAMA_PRIA}} &amp; {{NAMA_WANITA}}. Semoga menjadi keluarga yang sakinah, mawaddah, warahmah.</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- 9. PENUTUP / TERIMA KASIH -->\n    <footer class=\"py-16 px-6 text-center bg-cover bg-center text-[#F9F6F0]\" style=\"background-image: linear-gradient(to top, #161413 20%, rgba(22, 20, 19, 0.78) 100%), url('{{BG_1}}');\">\n      <div class=\"fade-up max-w-xs mx-auto\">\n        <h2 class=\"font-serif-luxury text-3xl font-semibold mb-3\">Terima Kasih</h2>\n        <p class=\"text-xs text-[#EFECE6]/80 leading-relaxed mb-6\">\n          Merupakan suatu kebahagiaan dan kehormatan bagi kami, apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu di hari bahagia kami.\n        </p>\n        <p class=\"uppercase tracking-[0.25em] text-[10px] text-[#C5B39B] mb-2\">Kami yang berbahagia,</p>\n        <h3 class=\"font-serif-luxury text-4xl font-semibold text-white mb-8\">\n          {{NAMA_PRIA}} <span class=\"font-script text-3xl text-[#C5B39B] font-normal\">&amp;</span> {{NAMA_WANITA}}\n        </h3>\n        <div class=\"w-12 h-[1px] bg-[#C5B39B]/30 mx-auto mb-4\"></div>\n        <p class=\"text-[10px] uppercase tracking-[0.25em] text-[#EFECE6]/50\">Digital Wedding Invitation</p>\n      </div>\n    </footer>\n\n  </main>\n\n  <!-- LIGHTBOX MODAL UNTUK GALERI -->\n  <div id=\"lightbox\" onclick=\"closeLightbox()\" class=\"fixed inset-0 z-50 hidden bg-black/90 flex items-center justify-center p-4\">\n    <img id=\"lightbox-img\" src=\"\" alt=\"Preview\" class=\"max-w-full max-h-[85vh] rounded-2xl shadow-2xl object-contain\" />\n  </div>\n\n  <!-- JAVASCRIPT INTERAKTIF -->\n  <script>\n    // 1. Ambil Nama Tamu dari Parameter URL (?to=NamaTamu)\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      const params = new URLSearchParams(window.location.search);\n      const guestName = params.get(\"to\");\n      const displayEl = document.getElementById(\"nama-tamu-display\");\n      const inputNama = document.getElementById(\"input-nama\");\n\n      if (guestName && guestName.trim() !== \"\") {\n        displayEl.textContent = guestName;\n        if (inputNama) inputNama.value = guestName;\n      }\n\n      // Inisialisasi Countdown\n      initCountdown();\n\n      // Inisialisasi Observer Animasi Scroll\n      const observer = new IntersectionObserver((entries) => {\n        entries.forEach((entry) => {\n          if (entry.isIntersecting) {\n            entry.target.classList.add(\"visible\");\n          }\n        });\n      }, { threshold: 0.12 });\n\n      document.querySelectorAll(\".fade-up\").forEach((el) => observer.observe(el));\n    });\n\n    // 2. Fungsi Buka Undangan & Putar Musik Otomatis\n    const bgm = document.getElementById(\"bgm\");\n    const musicBtn = document.getElementById(\"music-btn\");\n    const musicIcon = document.getElementById(\"music-icon\");\n    let isPlaying = false;\n\n    function openInvitation() {\n      const cover = document.getElementById(\"cover-overlay\");\n      cover.style.transform = \"translateY(-100%)\";\n      cover.style.opacity = \"0\";\n      document.body.classList.remove(\"lock-scroll\");\n\n      setTimeout(() => {\n        cover.style.display = \"none\";\n      }, 950);\n\n      // Tampilkan & Putar Musik jika URL tersedia\n      const musicSource = bgm.querySelector(\"source\").getAttribute(\"src\");\n      if (musicSource && !musicSource.includes(\"{{MUSIC_URL}}\") && musicSource.trim() !== \"\") {\n        musicBtn.classList.remove(\"hidden\");\n        bgm.play().then(() => {\n          isPlaying = true;\n          musicIcon.classList.add(\"spin-slow\");\n        }).catch(() => {\n          isPlaying = false;\n          musicIcon.classList.remove(\"spin-slow\");\n        });\n      } else {\n        // Tetap tampilkan tombol musik secara visual untuk template\n        musicBtn.classList.remove(\"hidden\");\n      }\n    }\n\n    function toggleMusic() {\n      if (bgm.paused) {\n        bgm.play().then(() => {\n          isPlaying = true;\n          musicIcon.classList.add(\"spin-slow\");\n        }).catch(() => {});\n      } else {\n        bgm.pause();\n        isPlaying = false;\n        musicIcon.classList.remove(\"spin-slow\");\n      }\n    }\n\n    // 3. Fungsi Salin Nomor Rekening\n    function copyAccount() {\n      const accountText = document.getElementById(\"rekening-number\").innerText.trim();\n      const copyText = document.getElementById(\"copy-text\");\n      const toast = document.getElementById(\"copy-toast\");\n\n      const tempInput = document.createElement(\"textarea\");\n      tempInput.value = accountText;\n      document.body.appendChild(tempInput);\n      tempInput.select();\n      document.execCommand(\"copy\");\n      document.body.removeChild(tempInput);\n\n      copyText.innerText = \"Tersalin\";\n      toast.classList.remove(\"opacity-0\");\n\n      setTimeout(() => {\n        copyText.innerText = \"Salin\";\n        toast.classList.add(\"opacity-0\");\n      }, 2500);\n    }\n\n    // 4. Fungsi Hitung Mundur Dinamis dari {{TANGGAL_ACARA}}\n    function initCountdown() {\n      const rawDate = \"{{TANGGAL_ACARA}}\";\n      let targetDate = new Date(rawDate).getTime();\n\n      // Fallback jika placeholder belum diganti atau format teks bahasa Indonesia\n      if (isNaN(targetDate)) {\n        targetDate = new Date().getTime() + (30 * 24 * 60 * 60 * 1000);\n      }\n\n      setInterval(() => {\n        const now = new Date().getTime();\n        const diff = targetDate - now;\n\n        if (diff <= 0) return;\n\n        const d = Math.floor(diff / (1000 * 60 * 60 * 24));\n        const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\n        const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));\n        const s = Math.floor((diff % (1000 * 60)) / 1000);\n\n        document.getElementById(\"cd-days\").innerText = String(d).padStart(2, \"0\");\n        document.getElementById(\"cd-hours\").innerText = String(h).padStart(2, \"0\");\n        document.getElementById(\"cd-minutes\").innerText = String(m).padStart(2, \"0\");\n        document.getElementById(\"cd-seconds\").innerText = String(s).padStart(2, \"0\");\n      }, 1000);\n    }\n\n    // 5. Fungsi Form RSVP & Ucapan\n    function submitWish(e) {\n      e.preventDefault();\n      const nama = document.getElementById(\"input-nama\").value.trim();\n      const hadir = document.getElementById(\"input-hadir\").value;\n      const pesan = document.getElementById(\"input-pesan\").value.trim();\n      if (!nama || !pesan) return;\n\n      const list = document.getElementById(\"wish-list\");\n      const item = document.createElement(\"div\");\n      item.className = \"bg-[#F9F6F0] p-4 rounded-2xl border border-[#C5B39B]/25\";\n      item.innerHTML = `\n        <div class=\"flex justify-between items-center mb-1\">\n          <h4 class=\"font-semibold text-xs text-[#2C2623]\"></h4>\n          <span class=\"text-[10px] px-2.5 py-0.5 rounded-full bg-[#8C7355]/15 text-[#8C7355] font-medium\"></span>\n        </div>\n        <p class=\"text-xs text-[#2C2623]/75 leading-relaxed\"></p>\n      `;\n      item.querySelector(\"h4\").textContent = nama;\n      item.querySelector(\"span\").textContent = hadir;\n      item.querySelector(\"p\").textContent = pesan;\n\n      list.prepend(item);\n      document.getElementById(\"input-pesan\").value = \"\";\n    }\n\n    // 6. Lightbox Galeri\n    function openLightbox(src) {\n      const lb = document.getElementById(\"lightbox\");\n      const lbImg = document.getElementById(\"lightbox-img\");\n      lbImg.src = src;\n      lb.classList.remove(\"hidden\");\n    }\n\n    function closeLightbox() {\n      document.getElementById(\"lightbox\").classList.add(\"hidden\");\n    }\n  </script>\n</body>\n</html>"
  }
]